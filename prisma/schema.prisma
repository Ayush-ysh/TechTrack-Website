generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum EventStatus {
  DRAFT
  UPCOMING
  REGISTRATION_OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventCategory {
  HACKATHON
  IDEATHON
  WORKSHOP
  COMPETITION
  MEETUP
  SEMINAR
  OTHER
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  CANCELLED
  REJECTED
  ATTENDED
}

enum Division {
  LEADERSHIP
  DESIGN
  TECH
  MULTIMEDIA
  SOCIAL_MEDIA
  MANAGEMENT
}

enum TeamRegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  CANCELLED
  REJECTED
}

enum AnnouncementType {
  INFO
  EVENT
  RECRUITMENT
  IMPORTANT
}

enum ContactMessageStatus {
  NEW
  READ
  RESPONDED
  ARCHIVED
}

enum RecruitmentApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum ClubMemberStatus {
  PENDING_ONBOARDING
  ACTIVE
  ON_LEAVE
  ALUMNI
  INACTIVE
  REMOVED
}

enum MemberRole {
  TECHTRACK_LEAD
  TECHTRACK_CO_LEAD
  DEPARTMENT_LEAD
  DEPARTMENT_COORDINATOR
  MEMBER
  TRAINEE
  EVENT_COORDINATOR
}

enum DepartmentVisibility {
  PUBLIC
  MEMBERS_ONLY
  LEADERSHIP_ONLY
}

enum ProjectStatus {
  IDEA
  PLANNING
  ACTIVE
  BLOCKED
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectVisibility {
  CLUB
  DEPARTMENT
  PRIVATE_TEAM
  PUBLIC
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MeetingType {
  GENERAL
  DEPARTMENT
  PROJECT
  LEADERSHIP
  EVENT
  TRAINING
  OTHER
}

enum MeetingAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  NOT_MARKED
}

enum RecruitmentPipelineStatus {
  SUBMITTED
  SCREENING
  SHORTLISTED
  TASK_ASSIGNED
  TASK_SUBMITTED
  INTERVIEW
  SELECTED
  WAITLISTED
  REJECTED
  WITHDRAWN
}

enum RecruitmentRecommendation {
  STRONG_YES
  YES
  MAYBE
  NO
  STRONG_NO
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  CANCELLED
}

enum ResourceType {
  DOCUMENT
  LINK
  TEMPLATE
  GUIDE
  BRAND_ASSET
  CODE
  DESIGN
  VIDEO
  POLICY
  OTHER
}

enum ResourceVisibility {
  CLUB
  DEPARTMENT
  LEADERSHIP
  SPECIFIC_PROJECT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE
  MEETING_SCHEDULED
  MEETING_CHANGED
  PROJECT_ADDED
  ANNOUNCEMENT
  RECRUITMENT_REVIEW_ASSIGNED
  APPROVAL_REQUESTED
  APPROVAL_COMPLETED
  MEMBER_ONBOARDED
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String?
  image           String?
  phone           String?
  college         String?
  course          String?
  branch          String?
  year            String?
  role            UserRole  @default(STUDENT)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  eventRegistrations       EventRegistration[]
  teamRegistrations        TeamRegistrationMember[]
  teamRegistrationLeads    TeamRegistration[]    @relation("TeamLeader")
  recruitmentApplications  RecruitmentApplication[]
  adminActivityLog         AdminActivity[]
  passwordResetTokens      PasswordResetToken[]
  clubMember               ClubMember?

  @@index([email])
  // @@index([role]) - enum index not supported
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Event {
  id                     String        @id @default(cuid())
  slug                   String        @unique
  title                  String
  subtitle               String?
  tagline                String?
  shortDescription       String?
  description            String        @db.Text
  category               EventCategory
  status                 EventStatus   @default(DRAFT)
  poster                 String?
  banner                 String?
  startDate              DateTime
  endDate                DateTime?
  registrationOpenDate   DateTime?
  registrationDeadline   DateTime?
  registrationUrl        String?
  internalRegistrationEnabled Boolean  @default(true)
  venue                  String?
  room                   String?
  onlineUrl              String?
  teamMinSize            Int?          @default(1)
  teamMaxSize            Int?          @default(1)
  participantLimit       Int?
  allowWaitlist          Boolean       @default(false)
  prize                  String?
  rules                  String[]      @default([])
  eligibility            String?
  schedule               String?
  rounds                 Json?
  organizer              String?
  contactInformation     String?
  featured               Boolean       @default(false)
  published              Boolean       @default(false)
  cancelledReason        String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  registrations          EventRegistration[]
  teamRegistrations      TeamRegistration[]
  galleryAlbums          GalleryAlbum[]
  coordinators           EventCoordinator[]
  scheduleItems          EventScheduleItem[]
  organizerAssignments   EventOrganizerAssignment[]
  expenses               ClubExpense[]

  @@index([slug])
  // @@index([status]) - enum index not supported
  // @@index([category]) - enum index not supported
  @@index([startDate])
  @@index([featured])
  @@index([published])
}

model EventOrganizerAssignment {
  id        String   @id @default(cuid())
  eventId   String
  memberId  String
  role      String
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member    ClubMember @relation("EventOrganizerAssignments", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId, role])
  @@index([eventId])
  @@index([memberId])
}

model EventCoordinator {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  contact   String
  role      String?
  order     Int      @default(0)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventScheduleItem {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  location    String?
  order       Int      @default(0)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventRegistration {
  id                  String              @id @default(cuid())
  registrationNumber  String              @unique
  eventId             String
  userId              String
  participantType     String              @default("INDIVIDUAL")
  teamName            String?
  status              RegistrationStatus  @default(PENDING)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMembers         TeamRegistrationMember[] @relation("EventRegistrationTeamMembers")

  @@index([eventId])
  @@index([userId])
  @@index([registrationNumber])
  // @@index([status]) - enum index not supported
  @@unique([eventId, userId])
}

model TeamRegistration {
  id            String                     @id @default(cuid())
  eventId       String
  teamName      String
  leaderId      String
  status        TeamRegistrationStatus     @default(PENDING)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  event         Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leader        User                       @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members       TeamRegistrationMember[]

  @@index([eventId])
  @@index([leaderId])
  // @@index([status]) - enum index not supported
}

model TeamRegistrationMember {
  id                     String   @id @default(cuid())
  teamRegistrationId     String
  userId                 String?
  memberName             String
  email                  String
  phone                  String?
  college                String?
  role                   String?
  createdAt              DateTime @default(now())

  teamRegistration       TeamRegistration @relation(fields: [teamRegistrationId], references: [id], onDelete: Cascade, map: "TeamRegistrationMember_teamRegistration_fkey")
  user                   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventRegistration      EventRegistration? @relation("EventRegistrationTeamMembers", fields: [teamRegistrationId], references: [id], map: "TeamRegistrationMember_eventRegistration_fkey")

  @@index([teamRegistrationId])
  @@index([userId])
}

model TeamMember {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  role        String
  division    Division
  bio         String?
  photo       String?
  linkedin    String?
  instagram   String?
  github      String?
  portfolio   String?
  displayOrder Int      @default(0)
  active      Boolean   @default(true)
  featured    Boolean   @default(false)
  startYear   Int?
  endYear     Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // @@index([division]) - enum index not supported
  @@index([slug])
  @@index([active])
  @@index([displayOrder])
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  year        Int
  date        DateTime?
  category    String?
  image       String?
  externalUrl String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([slug])
  @@index([published])
  @@index([displayOrder])
}

model GalleryAlbum {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  eventId     String?
  coverImage  String?
  date        DateTime?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  images      GalleryImage[]

  @@index([slug])
  @@index([eventId])
  @@index([published])
}

model GalleryImage {
  id           String         @id @default(cuid())
  albumId      String
  imageUrl     String
  thumbnailUrl String?
  caption      String?
  photographer String?
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())

  album        GalleryAlbum   @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([displayOrder])
}

model Announcement {
  id        String            @id @default(cuid())
  title     String
  message   String            @db.Text
  type      AnnouncementType  @default(INFO)
  url       String?
  active    Boolean           @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([active])
  // @@index([type]) - enum index not supported
  @@index([startDate])
}

model RecruitmentDrive {
  id                String   @id @default(cuid())
  title             String
  description       String   @db.Text
  open              Boolean  @default(false)
  startDate         DateTime?
  deadline          DateTime?
  eligibleYears     String[]
  availableDivisions Division[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  applications      RecruitmentApplication[]

  @@index([open])
}

model RecruitmentApplication {
  id               String                       @id @default(cuid())
  driveId          String
  userId           String
  division         Division
  secondPreference Division?
  whyJoin          String                       @db.Text
  experience       String?
  portfolioUrl     String?
  githubUrl        String?
  linkedinUrl      String?
  status           RecruitmentApplicationStatus @default(SUBMITTED)
  pipelineStatus   RecruitmentPipelineStatus    @default(SUBMITTED)
  submittedAt      DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  drive            RecruitmentDrive             @relation(fields: [driveId], references: [id], onDelete: Cascade)
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews          RecruitmentReview[]
  interviews       InterviewSession[]

  @@index([driveId])
  @@index([userId])
  // @@index([status]) - enum index not supported
  // @@index([pipelineStatus]) - enum index not supported
  // @@index([division]) - enum index not supported
  @@unique([driveId, userId])
}

model ContactMessage {
  id        String                 @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String                 @db.Text
  status    ContactMessageStatus   @default(NEW)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  // @@index([status]) - enum index not supported
  @@index([createdAt])
}

model ClubSettings {
  id              String   @id @default(cuid())
  clubName        String   @default("TECHTRACK")
  collegeName     String?
  description     String?  @db.Text
  mission         String?  @db.Text
  vision          String?  @db.Text
  foundedYear     Int?
  email           String?
  instagram       String?
  linkedin        String?
  github          String?
  location        String?
  recruitmentOpen Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminActivity {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Department {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  icon          String?
  image         String?
  colorAccent   String?
  displayOrder  Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       ClubMember[]
  projects      Project[]
  meetings      ClubMeeting[]
  resources     ClubResource[]
  announcements InternalAnnouncement[]
  tasks         Task[]

  @@index([slug])
  @@index([active])
  @@index([displayOrder])
}

model ClubMember {
  id                String         @id @default(cuid())
  userId            String?        @unique
  name              String
  slug              String         @unique
  divisionId        String
  primaryRole       MemberRole
  secondaryRole     MemberRole?
  membershipStatus  ClubMemberStatus @default(PENDING_ONBOARDING)
  joinDate          DateTime?
  exitDate          DateTime?
  academicYear      String?
  college           String?
  course            String?
  branch            String?
  year              String?
  bio               String?        @db.Text
  image             String?
  linkedin          String?
  github            String?
  instagram         String?
  portfolio         String?
  displayOrder      Int            @default(0)
  featured          Boolean        @default(false)
  publicProfile     Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  division          Department     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  projectMembers    ProjectMember[]
  taskAssignments   Task[]         @relation("TaskAssignee")
  tasksAssigned     Task[]         @relation("TaskAssignedBy")
  meetingAttendance MeetingAttendance[]
  meetingOrganized  ClubMeeting[]  @relation("MeetingOrganizer")
  recruitmentReviews RecruitmentReview[] @relation("RecruitmentReviews")
  interviewSessions InterviewSession[] @relation("InterviewSessions")
  resourceUploads   ClubResource[] @relation("ResourceUploader")
  approvalRequests  Approval[]     @relation("ApprovalRequester")
  approvalDecisions Approval[]     @relation("ApprovalDecider")
  taskComments      TaskComment[]
  notifications     Notification[]
  eventOrganizerAssignments EventOrganizerAssignment[] @relation("EventOrganizerAssignments")
  ownedProjects     Project[]      @relation("ProjectOwner")
  expenseSubmitted  ClubExpense[]  @relation("ExpenseSubmittedBy")
  expenseApproved   ClubExpense[]  @relation("ExpenseApprovedBy")
  memberAvailability MemberAvailability[] @relation("MemberAvailability")
  projectAnnouncements InternalAnnouncement[] @relation("ProjectAnnouncements")

  @@index([divisionId])
  @@index([slug])
  @@index([membershipStatus])
  @@index([primaryRole])
  @@index([userId])
}

model Project {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String?         @db.Text
  status        ProjectStatus   @default(IDEA)
  priority      TaskPriority    @default(MEDIUM)
  departmentId  String?
  ownerId       String
  startDate     DateTime?
  targetDate    DateTime?
  completedAt   DateTime?
  coverImage    String?
  repositoryUrl String?
  demoUrl       String?
  designUrl     String?
  documentationUrl String?
  visibility    ProjectVisibility @default(CLUB)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  department    Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  owner         ClubMember      @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  tasks         Task[]
  meetings      ClubMeeting[]
  announcements InternalAnnouncement[] @relation("ProjectAnnouncements")
  resources     ClubResource[] @relation("ProjectResources")
  expenses      ClubExpense[]  @relation("ProjectExpenses")

  @@index([slug])
  // @@index([status]) - enum index not supported
  @@index([departmentId])
  @@index([ownerId])
  @@index([visibility])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  memberId  String
  role      String
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([projectId])
  @@index([memberId])
}

model Task {
  id            String      @id @default(cuid())
  projectId     String?
  title         String
  description   String?     @db.Text
  status        TaskStatus  @default(BACKLOG)
  priority      TaskPriority @default(MEDIUM)
  assigneeId    String?
  assignedById  String?
  departmentId  String?
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      ClubMember?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedBy    ClubMember?    @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  comments      TaskComment[]

  @@index([projectId])
  @@index([assigneeId])
  // @@index([status]) - enum index not supported
  @@index([departmentId])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    ClubMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model ClubMeeting {
  id              String                 @id @default(cuid())
  title           String
  description     String?                @db.Text
  departmentId    String?
  projectId       String?
  organizerId     String
  startAt         DateTime
  endAt           DateTime?
  venue           String?
  meetingUrl      String?
  type            MeetingType            @default(GENERAL)
  attendanceRequired Boolean             @default(false)
  status          String                 @default("SCHEDULED")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  department      Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project         Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  organizer       ClubMember             @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  attendance      MeetingAttendance[]

  @@index([departmentId])
  @@index([projectId])
  @@index([organizerId])
  @@index([startAt])
  @@index([type])
}

model MeetingAttendance {
  id        String                   @id @default(cuid())
  meetingId String
  memberId  String
  status    MeetingAttendanceStatus  @default(NOT_MARKED)
  checkedAt DateTime?
  markedBy  String?
  note      String?

  meeting   ClubMeeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member    ClubMember               @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetingId, memberId])
  @@index([meetingId])
  @@index([memberId])
}

model InternalAnnouncement {
  id            String   @id @default(cuid())
  title         String
  message       String   @db.Text
  type          AnnouncementType @default(INFO)
  url           String?
  target        String
  targetId      String?
  departmentId  String?
  projectId     String?
  authorId      String
  active        Boolean  @default(true)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project       Project?    @relation("ProjectAnnouncements", fields: [projectId], references: [id], onDelete: SetNull)
  author        ClubMember  @relation("ProjectAnnouncements", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([target])
  @@index([departmentId])
  @@index([createdAt])
}

model ClubResource {
  id            String           @id @default(cuid())
  title         String
  description   String?          @db.Text
  category      ResourceType
  departmentId  String?
  projectId     String?
  url           String?
  fileUrl       String?
  visibility    ResourceVisibility @default(CLUB)
  uploadedById  String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project       Project?         @relation("ProjectResources", fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy    ClubMember       @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([departmentId])
  @@index([visibility])
  @@index([uploadedById])
  @@index([createdAt])
}

model RecruitmentReview {
  id              String                 @id @default(cuid())
  applicationId   String
  reviewerId      String
  score           Int?
  recommendation  RecruitmentRecommendation?
  notes           String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  application     RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer        ClubMember             @relation("RecruitmentReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([reviewerId])
}

model InterviewSession {
  id              String                 @id @default(cuid())
  applicationId   String
  scheduledAt     DateTime
  endAt           DateTime?
  venue           String?
  meetingUrl      String?
  interviewerId   String
  status          String                 @default("SCHEDULED")
  score           Int?
  notes           String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  application     RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer     ClubMember             @relation("InterviewSessions", fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([interviewerId])
  @@index([scheduledAt])
}

model Approval {
  id            String           @id @default(cuid())
  requesterId   String
  deciderId     String?
  resourceType  String
  resourceId    String
  status        ApprovalStatus   @default(PENDING)
  comment       String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  requester     ClubMember       @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decider       ClubMember?      @relation("ApprovalDecider", fields: [deciderId], references: [id], onDelete: SetNull)

  @@index([requesterId])
  @@index([deciderId])
  @@index([resourceType, resourceId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  url       String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      ClubMember       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model MemberOnboarding {
  id            String   @id @default(cuid())
  memberId      String
  step          String
  completed     Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([memberId, step])
  @@index([memberId])
}

model ClubExpense {
  id            String   @id @default(cuid())
  projectId     String?
  eventId       String?
  submittedById String
  category      String
  description   String
  estimatedCost Decimal? @db.Decimal(10, 2)
  actualCost    Decimal? @db.Decimal(10, 2)
  receiptUrl    String?
  status        String   @default("PENDING")
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project?     @relation("ProjectExpenses", fields: [projectId], references: [id], onDelete: SetNull)
  event         Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  submittedBy   ClubMember   @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  approvedBy    ClubMember?  @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([eventId])
  @@index([submittedById])
  @@index([status])
}

model MemberAvailability {
  id        String   @id @default(cuid())
  memberId  String
  status    String   @default("AVAILABLE")
  note      String?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member    ClubMember @relation("MemberAvailability", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  // @@index([status]) - enum index not supported
}